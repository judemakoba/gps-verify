<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        NOTE: this app declares NO permissions at all.

        There is deliberately no android.permission.INTERNET, so the APK cannot
        open a network connection even if some code tried to. Every site record
        ships inside the APK and every lookup is answered on the handset.
        Verify with:
          aapt dump permissions gps-verify.apk
    -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GPSVerify">

        <activity
            android:name=".LookupActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BrowseActivity"
            android:exported="false"
            android:label="@string/browse_title"
            android:parentActivityName=".LookupActivity" />

    </application>

</manifest>
