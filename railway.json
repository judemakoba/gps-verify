{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "planPath": "node"
    }
  },
  "deploy": {
    "sourceDir": "./backend",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "volumeMounts": {
    "data": {
      "mountPath": "/app/data",
      "disk": true,
      "subDirectory": "./backend/data"
    }
  }
}
